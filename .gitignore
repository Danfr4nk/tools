stylometry/v3/runs/
stylometry/v3/windows/
stylometry/v3/queue/
stylometry/v3/state/
stylometry/v3/audit/
stylometry/v3/*.jsonl
stylometry/**/entity_candidates.jsonl
stylometry/**/labels.jsonl
stylometry/**/cron.log

__pycache__/
*.py[cod]
.DS_Store

